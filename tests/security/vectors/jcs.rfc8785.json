{
  "name": "JSON Canonicalization Scheme (RFC 8785)",
  "source": [
    "https://www.rfc-editor.org/rfc/rfc8785#section-3.2.2",
    "https://www.rfc-editor.org/rfc/rfc8785#section-3.2.3",
    "https://www.rfc-editor.org/rfc/rfc8785#section-3.2.4",
    "https://www.rfc-editor.org/rfc/rfc8785#appendix-B"
  ],
  "notes": "inputJson is raw JSON text to be parsed first; expectedUtf8Hex are the exact canonical bytes. numberSamples use IEEE 754 binary64 bit patterns (hex, big-endian).",
  "canonicalization": [
    {
      "id": "rfc8785-3.2.2-to-3.2.4",
      "inputJson": "{\n  \"numbers\": [333333333.33333329, 1E30, 4.50,\n              2e-3, 0.000000000000000000000000001],\n  \"string\": \"\\u20ac$\\u000F\\u000aA'\\u0042\\u0022\\u005c\\\\\\\"\\/\",\n  \"literals\": [null, true, false]\n}",
      "expectedUtf8Hex": "7b226c69746572616c73223a5b6e756c6c2c747275652c66616c73655d2c226e756d62657273223a5b3333333333333333332e333333333333332c31652b33302c342e352c302e3030322c31652d32375d2c22737472696e67223a22e282ac245c75303030665c6e4127425c225c5c5c5c5c222f227d",
      "expectedText": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"€$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}"
    }
  ],
  "propertySorting": [
    {
      "id": "rfc8785-3.2.3-sorting",
      "inputJson": "{\n  \"\\u20ac\": \"Euro Sign\",\n  \"\\r\": \"Carriage Return\",\n  \"\\ufb33\": \"Hebrew Letter Dalet With Dagesh\",\n  \"1\": \"One\",\n  \"\\ud83d\\ude00\": \"Emoji: Grinning Face\",\n  \"\\u0080\": \"Control\",\n  \"\\u00f6\": \"Latin Small Letter O With Diaeresis\"\n}",
      "expectedValueOrder": [
        "Carriage Return",
        "One",
        "Control",
        "Latin Small Letter O With Diaeresis",
        "Euro Sign",
        "Emoji: Grinning Face",
        "Hebrew Letter Dalet With Dagesh"
      ]
    }
  ],
